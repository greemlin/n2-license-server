# N2 License Server configuration
# Copy this file to .env and fill in the real values before deployment.

# Admin credentials
ADMIN_USERNAME=admin
# Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt(rounds=12)).decode())"
ADMIN_PASSWORD_HASH=

# Session / cookie signing (change to a long random string)
SECRET_KEY=change-me-to-a-long-random-secret-min-32-bytes

# SQLite path (default) or PostgreSQL URL
DATABASE_URL=sqlite:///./data/license_server.db

# Default license policy
DEFAULT_OFFLINE_GRACE_DAYS=10
DEFAULT_ACTIVATION_LIMIT=1

# Optional: Sentry DSN for server-side error tracking
SENTRY_DSN=
